		<title><![CDATA[ما هو انحراف العين البسيط]]></title>
		<link>http://drhebametwally.com/%d8%ad%d9%88%d9%84-%d8%a7%d9%84%d8%b9%d9%8a%d9%86%d9%8a%d9%86-%d8%a7%d9%88-%d8%a7%d9%86%d8%ad%d8%b1%d8%a7%d9%81-%d8%a7%d9%84%d9%86%d8%b8%d8%b1/</link>
		<pubDate>Sun, 29 Oct 2023 12:53:14 +0000</pubDate>
