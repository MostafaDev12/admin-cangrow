<IfModule mod_rewrite.c>
RewriteEngine On

# Remove www
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Redirect specific Arabic URL to homepage (put this **before** public rewrite)
RewriteRule ^علاج-ضمور-العصب-البصري-في-مصر/?$ https://abdelrhmanshams.com/ [R=301,L]

RewriteRule ^تكلفة-عملية-المياه-البيضاء-في-العين/?$ /سعر-عملية-المياه-البيضاء/ [R=301,L]

RewriteRule ^اسعار-عمليات-الليزك-في-مصر/?$ /سعر-عملية-الليزك-في-مصر/ [R=301,L]

# Rewrite to public folder (only if not matched above)
RewriteRule ^(.*)$ public/$1 [L]

# Authorization header support (for APIs etc.)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_flag display_errors On
   php_value max_execution_time 200000
   php_value max_input_time 200000
   php_value max_input_vars 500000
   php_value memory_limit -1
   php_value post_max_size 300M
   php_value session.gc_maxlifetime 2000
   php_value session.save_path "/var/cpanel/php/sessions/ea-php81"
   php_value upload_max_filesize 25M
   php_flag zlib.output_compression Off
</IfModule>
<IfModule lsapi_module>
   php_flag display_errors On
   php_value max_execution_time 200000
   php_value max_input_time 200000
   php_value max_input_vars 500000
   php_value memory_limit -1
   php_value post_max_size 300M
   php_value session.gc_maxlifetime 2000
   php_value session.save_path "/var/cpanel/php/sessions/ea-php81"
   php_value upload_max_filesize 25M
   php_flag zlib.output_compression Off
</IfModule>
# END cPanel-generated php ini directives, do not edit

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
